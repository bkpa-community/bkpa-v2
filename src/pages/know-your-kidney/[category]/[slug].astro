---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { categoryBySlug } from "../../../lib/categories";

export async function getStaticPaths() {
  const all = await getCollection("articles", (a) => !a.data.draft);
  return all.map((a) => {
    const [category, ...rest] = a.id.split("/");
    return { params: { category, slug: rest.join("/") }, props: { entry: a } };
  });
}

const { category } = Astro.params;
const cat = categoryBySlug(category)!;
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description || cat.labelEn}>
  <article class="py-12">
    <div class="mx-auto max-w-3xl px-6 md:px-10">
      <a class="font-mono text-[0.72rem] tracking-wider text-(--color-ink-soft) uppercase hover:text-(--color-accent)" href={`/know-your-kidney/${cat.slug}`}>
        ← <span class="i18n-en">{cat.labelEn}</span><span class="i18n-bn bn">{cat.labelBn}</span>
      </a>
      <h1 class="mt-3 font-display text-[clamp(1.7rem,3.6vw,2.4rem)] font-semibold text-balance text-(--color-deep)">{entry.data.title}</h1>
      {entry.data.date && (
        <time class="mt-2 block font-mono text-xs text-(--color-ink-soft)" datetime={entry.data.date.toISOString()}>
          {entry.data.date.toLocaleDateString("en-CA")}
        </time>
      )}
      {entry.data.image && <img class="mt-6 w-full rounded-lg border border-(--color-line) object-cover" src={encodeURI(entry.data.image)} alt="" loading="eager" />}
      <div class="prose-bkpa mt-8">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
