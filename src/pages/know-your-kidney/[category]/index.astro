---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CategoryIcon from "../../../components/CategoryIcon.astro";
import { getCollection } from "astro:content";
import { CATEGORIES, categoryBySlug } from "../../../lib/categories";

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}

function excerpt(markdown: string, maxLength = 160) {
  const plain = markdown
    .replace(/^#+\s*/gm, "")
    .replace(/\*\*(.*?)\*\*/g, "$1")
    .replace(/\*(.*?)\*/g, "$1")
    .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
    .replace(/[*_>`~#]/g, "")
    .replace(/\s+/g, " ")
    .trim();
  return plain.length > maxLength ? `${plain.slice(0, maxLength).trim()}...` : plain;
}

const { category } = Astro.params;
const cat = categoryBySlug(category)!;
const all = await getCollection("articles", (a) => !a.data.draft);
const items = all
  .filter((a) => a.id.startsWith(`${cat.slug}/`))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title={cat.labelEn} description={`${cat.labelEn} — articles from BKPA Foundation`}>
  <section class="py-12">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <p class="font-mono text-[0.72rem] tracking-wider text-(--color-ink-soft) uppercase">
        <span class="i18n-bn bn">কিডনি সম্পর্কে জানুন</span><span class="i18n-en">Know Your Kidney</span>
      </p>
      <h1 class="mt-1.5 flex items-center gap-3 font-display text-[clamp(1.8rem,4vw,2.6rem)] font-semibold text-(--color-ink)">
        <CategoryIcon slug={cat.slug} class="h-8 w-8 flex-none text-(--color-deep)" />
        <span>
          <span class="i18n-en">{cat.labelEn}</span>
          <span class="i18n-bn bn block">{cat.labelBn}</span>
        </span>
      </h1>

      {items.length === 0 && (
        <p class="mt-8 text-(--color-ink-soft)">
          <span class="i18n-bn bn-body">এই ক্যাটাগরিতে এখনো কোনো আর্টিকেল যোগ করা হয়নি।</span>
          <span class="i18n-en">No articles have been published in this category yet.</span>
        </p>
      )}

      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((a) => (
          <a
            class="group flex flex-col overflow-hidden rounded-lg border border-(--color-line) bg-(--color-surface) hover:border-(--color-deep)"
            href={`${base}/know-your-kidney/${cat.slug}/${a.id.split("/").slice(1).join("/")}`}
          >
            {a.data.image && (
              <div class="aspect-video overflow-hidden bg-(--color-surface-2)">
                <img
                  class="h-full w-full object-cover transition group-hover:scale-105"
                  src={encodeURI(`${base}${a.data.image}`)}
                  alt=""
                  loading="lazy"
                />
              </div>
            )}
            <div class="flex flex-1 flex-col p-5">
              <h2 class="font-display text-[1.05rem] font-semibold leading-snug">{a.data.title}</h2>
              <p class="mt-2 line-clamp-3 flex-1 text-sm text-(--color-ink-soft)">{excerpt(a.body ?? "")}</p>
              {a.data.date && (
                <time class="mt-3 block font-mono text-xs text-(--color-ink-soft)" datetime={a.data.date.toISOString()}>
                  {a.data.date.toLocaleDateString("en-CA")}
                </time>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
