---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";

const about = (await getEntry("siteAbout", "main"))!.data;
const members = (await getCollection("team")).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Executive Body" description={about.description}>
  <section class="py-12">
    <div class="mx-auto max-w-5xl px-6 md:px-10">
      <p class="font-mono text-[0.72rem] tracking-wider text-(--color-ink-soft) uppercase"><span class="i18n-bn bn">সংগঠন</span><span class="i18n-en">Organization</span></p>
      <h1 class="mt-1.5 font-display text-[clamp(1.8rem,4vw,2.6rem)] font-semibold text-(--color-deep)">
        <span class="i18n-bn bn">কার্যনির্বাহী পরিষদ</span><span class="i18n-en">Executive Body</span>
      </h1>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {members.map((m) => (
          <div class="rounded-lg border border-(--color-line) bg-(--color-surface) p-5">
            {m.data.image && (
              <img class="mb-4 h-16 w-16 rounded-full border border-(--color-line) object-cover" src={encodeURI(m.data.image)} alt={m.data.name} loading="lazy" />
            )}
            <h2 class="font-display text-[1.02rem] font-semibold">{m.data.name}</h2>
            {m.data.role && <p class="mt-1 text-sm text-(--color-ink-soft)">{m.data.role}</p>}
            <div class="mt-3 flex flex-col gap-1 font-mono text-xs text-(--color-ink-soft) tabular-nums">
              {m.data.phone && <a class="hover:text-(--color-deep)" href={`tel:${m.data.phone}`}>{m.data.phone}</a>}
              {m.data.email && <a class="hover:text-(--color-deep)" href={`mailto:${m.data.email}`}>{m.data.email}</a>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
