    { id: "find-doctor", en: "Find a nephrologist", bn: "নেফ্রোলজিস্ট খুঁজছি" },
  ],
  diet: [
    { id: "renal-diet", en: "Renal diet guidelines", bn: "রেনাল ডায়েট নির্দেশিকা" },
    { id: "diabetes", en: "Diabetes & kidney health", bn: "ডায়াবেটিস ও কিডনি স্বাস্থ্য" },
    { id: "general", en: "General kidney health tips", bn: "কিডনি স্বাস্থ্যের সাধারণ টিপস" },
