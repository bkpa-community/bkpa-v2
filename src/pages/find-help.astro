    { id: "vascular", en: "Vascular / fistula surgeon", bn: "ভাস্কুলার / ফিস্টুলা সার্জন" },
    { id: "dialysis-center", en: "Dialysis center", bn: "ডায়ালাইসিস সেন্টার" },
    { id: "blood", en: "Blood bank", bn: "ব্লাড ব্যাংক" },
