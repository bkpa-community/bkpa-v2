const NEEDS: Record<string, { id: string; en: string; bn: string }[]> = {
  basics: [
    { id: "what-is", en: "What is a kidney and how does it work?", bn: "কিডনি কী ও কীভাবে কাজ করে?" },
    { id: "ckd", en: "Chronic Kidney Disease (CKD)", bn: "ক্রনিক কিডনি ডিজিজ (CKD)" },
    { id: "aki", en: "Acute Kidney Injury (AKI)", bn: "একিউট কিডনি ইনজুরি (AKI)" },
