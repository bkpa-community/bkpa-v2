---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const PERSONAS = [
  { id: "patient", en: "Kidney Patient", bn: "কিডনি রোগী" },
  { id: "caregiver", en: "Family / Caregiver", bn: "পরিবার / কেয়ারগিভার" },
  { id: "professional", en: "Healthcare Professional", bn: "স্বাস্থ্যকর্মী" },
  { id: "learner", en: "Just Learning", bn: "জানতে চাই" },
] as const;

const TOPICS = [
