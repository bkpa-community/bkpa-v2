---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, getEntry } from "astro:content";
import { CATEGORIES, EMERGENCY_CATEGORIES } from "../lib/categories";

const home = (await getEntry("siteHome", "main"))!.data;
const [featured, ...rest] = home.banners;

const articles = await getCollection("articles", (a) => !a.data.draft);
const countFor = (slug: string) => articles.filter((a) => a.id.startsWith(`${slug}/`)).length;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

---

<BaseLayout title="Home" description="Detect early, protect kidney health — BKPA Foundation, Bangladesh's first comprehensive Bengali-language kidney health resource.">
  <!-- ============ HERO ============ -->
  <section class="pt-14 pb-12 lg:pt-20 lg:pb-16">
    <div class="mx-auto grid max-w-6xl items-center gap-11 px-6 md:px-10 lg:grid-cols-[1.05fr_.95fr] lg:gap-14">
      <div>
        <p class="font-mono text-[0.72rem] tracking-wider text-(--color-ink-soft) uppercase">
          <span class="i18n-bn bn">নন-প্রফিট চ্যারিটেবল অ্যাসোসিয়েশন · প্রতিষ্ঠা ২০১৫</span>
          <span class="i18n-en">Non-Profit Charitable Association · Est. 2015</span>
        </p>
        <h1 class="mt-3 font-display text-[clamp(2.15rem,5.4vw,3.4rem)] leading-[1.08] font-semibold text-balance text-(--color-deep)">
          {featured?.title ?? "Are your kidneys OK?"}
        </h1>
        {featured?.content && (
          <p class="mt-4 max-w-xl whitespace-pre-line text-[1.1rem] text-(--color-ink-soft)">{featured.content}</p>
        )}
        <p class="mt-2.5 font-display text-[1.05rem] text-(--color-accent-2) italic">
          <span class="i18n-bn bn">"কিডনি সেবায় জ্ঞানের ব্যবধান কমিয়ে আনা"</span>
          <span class="i18n-en">"Bridging the knowledge gap to better kidney care."</span>
        </p>
        <div class="mt-7 flex flex-wrap gap-3.5">
          <a class="inline-flex items-center gap-2 rounded-md bg-(--color-accent) px-5.5 py-3 text-sm font-semibold text-(--color-accent-ink) hover:brightness-110" href={`${base}/emergency-contacts/nephrology-doctors`}>
            <span class="i18n-bn bn">জরুরি সহায়তা</span><span class="i18n-en">Emergency Help</span>
          </a>
          <a class="inline-flex items-center gap-2 rounded-md border border-(--color-line) px-5.5 py-3 text-sm font-semibold hover:bg-(--color-surface-2)" href={`${base}/know-your-kidney/kidney-basic`}>
            <span class="i18n-bn bn">কিডনি সম্পর্কে জানুন</span><span class="i18n-en">Know Your Kidney</span>
          </a>
        </div>
      </div>

      <div class="relative mx-auto aspect-square w-full max-w-md">
        <svg viewBox="0 0 400 400" class="h-full w-full">
          <path d="M200 40c-70 0-120 62-120 138 0 96 48 172 120 172s120-76 120-172C320 102 270 40 200 40Z" fill="var(--color-surface-2)"></path>
          <path d="M200 40c-70 0-120 62-120 138 0 96 48 172 120 172" fill="none" stroke="var(--color-deep)" stroke-width="2" opacity=".5"></path>
          <path d="M162 150c0-30 20-52 44-52s44 26 44 58-18 46-40 46c-14 0-22-8-22-20 0-14 12-20 26-16" fill="none" stroke="var(--color-accent)" stroke-width="6" stroke-linecap="round"></path>
          <circle cx="200" cy="150" r="7" fill="var(--color-accent-2)"></circle>
        </svg>
        <div class="absolute bottom-[-1.1rem] left-1/2 flex w-max max-w-[92%] -translate-x-1/2 items-center gap-2.5 rounded-lg border border-(--color-line) bg-(--color-surface) px-4.5 py-3 shadow-xl">
          <span class="h-2.5 w-2.5 flex-none rounded-full bg-(--color-accent-2)"></span>
          <div>
            <strong class="block text-[0.82rem]"><span class="i18n-bn bn">সরকার নিবন্ধিত</span><span class="i18n-en">Government Registered</span></strong>
            <span class="text-[0.72rem] text-(--color-ink-soft)"><span class="i18n-bn bn">নন-প্রফিট প্রতিষ্ঠান</span><span class="i18n-en">Registered non-profit foundation</span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ NOTICE BOARD ============ -->
  {home.notice.enable && (
    <div class="border-y border-(--color-line) bg-(--color-accent) text-(--color-accent-ink)">
      <div class="mx-auto max-w-6xl px-6 py-5 md:px-10">
        <p class="font-semibold">{home.notice.title}</p>
        <p class="mt-1.5 max-w-3xl whitespace-pre-line text-sm opacity-90">{home.notice.content}</p>
      </div>
    </div>
  )}

  <!-- ============ VITALS ============ -->
  <div class="border-b border-(--color-line) bg-(--color-surface)">
    <div class="mx-auto grid max-w-6xl grid-cols-1 sm:grid-cols-3">
      <div class="border-b border-(--color-line) px-6 py-5 sm:border-r sm:border-b-0 md:px-10">
        <div class="font-mono text-[1.3rem] font-semibold text-(--color-deep) tabular-nums">2015</div>
        <div class="mt-1 text-sm text-(--color-ink-soft)"><span class="i18n-bn bn">এপ্রিল মাসে প্রতিষ্ঠিত</span><span class="i18n-en">Founded in April</span></div>
      </div>
      <div class="border-b border-(--color-line) px-6 py-5 sm:border-r sm:border-b-0 md:px-10">
        <div class="font-mono text-[1.1rem] font-semibold text-(--color-deep)"><span class="i18n-bn bn">প্রথম বাংলা রিসোর্স</span><span class="i18n-en">First of its kind</span></div>
        <div class="mt-1 text-sm text-(--color-ink-soft)"><span class="i18n-bn bn">বাংলাদেশের প্রথম সম্পূর্ণ বাংলা কিডনি স্বাস্থ্য রিসোর্স</span><span class="i18n-en">Bangladesh's first full Bengali-language kidney resource</span></div>
      </div>
      <div class="px-6 py-5 md:px-10">
        <div class="font-mono text-[1.3rem] font-semibold text-(--color-deep) tabular-nums">{articles.length}+</div>
        <div class="mt-1 text-sm text-(--color-ink-soft)"><span class="i18n-bn bn">শিক্ষামূলক আর্টিকেল</span><span class="i18n-en">Educational articles</span></div>
      </div>
    </div>
  </div>

  <!-- ============ MORE FROM BKPA (remaining banners) ============ -->
  {rest.length > 0 && (
    <section class="py-14">
      <div class="mx-auto max-w-6xl px-6 md:px-10">
        <div class="grid gap-4 md:grid-cols-2">
          {rest.slice(0, 4).map((b) => (
            <div class="rounded-lg border border-(--color-line) border-l-4 border-l-(--color-accent-2) bg-(--color-surface) p-6">
              <span class="mb-1.5 inline-block font-mono text-[0.68rem] tracking-wider text-(--color-accent-2) uppercase">
                <span class="i18n-bn bn">আপডেট</span><span class="i18n-en">Update</span>
              </span>
              <h3 class="font-display text-[1.05rem] font-semibold">{b.title}</h3>
              {b.content && <p class="mt-1.5 max-w-xl whitespace-pre-line text-sm text-(--color-ink-soft)">{b.content}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ============ KNOW YOUR KIDNEY ============ -->
  <section class="py-14" id="topics">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <div class="mb-8 max-w-xl">
        <p class="font-mono text-[0.72rem] tracking-wider text-(--color-ink-soft) uppercase"><span class="i18n-bn bn">শিক্ষামূলক রিসোর্স</span><span class="i18n-en">Educational Resource</span></p>
        <h2 class="mt-1.5 font-display text-[clamp(1.5rem,3vw,2rem)] font-semibold text-(--color-deep)"><span class="i18n-bn bn">আপনার কিডনি সম্পর্কে জানুন</span><span class="i18n-en">Know Your Kidney</span></h2>
        <p class="mt-2 text-(--color-ink-soft)"><span class="i18n-bn bn-body">কিডনির গঠন থেকে ডায়ালাইসিস ও প্রতিস্থাপন পর্যন্ত — প্রতিটি বিষয় সহজ বাংলায় ব্যাখ্যা করা।</span><span class="i18n-en">From kidney basics to dialysis and transplantation — every topic explained in plain Bengali and English.</span></p>
      </div>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {CATEGORIES.map((c) => (
          <a class="flex min-h-[8.5rem] flex-col justify-between gap-3 rounded-lg border border-(--color-line) bg-(--color-surface) p-5 hover:border-(--color-deep)" href={`${base}/know-your-kidney/${c.slug}`}>
            <div>
              <p class="text-sm font-semibold leading-tight">
                <span class="i18n-en">{c.labelEn}</span>
                <span class="i18n-bn bn block">{c.labelBn}</span>
              </p>
            </div>
            <span class="font-mono text-xs text-(--color-ink-soft) tabular-nums">{countFor(c.slug)} <span class="i18n-bn bn">টি আর্টিকেল</span><span class="i18n-en">articles</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ EMERGENCY ============ -->
  <section class="bg-(--color-accent) py-14 text-(--color-accent-ink)" id="emergency">
    <div class="mx-auto max-w-6xl px-6 md:px-10">
      <div class="mb-8 max-w-xl">
        <p class="font-mono text-[0.72rem] tracking-wider opacity-75 uppercase"><span class="i18n-bn bn">তাৎক্ষণিক প্রয়োজনে</span><span class="i18n-en">When you need it now</span></p>
        <h2 class="mt-1.5 font-display text-[clamp(1.5rem,3vw,2rem)] font-semibold"><span class="i18n-bn bn">জরুরি যোগাযোগ</span><span class="i18n-en">Emergency Contacts</span></h2>
        <p class="mt-2 opacity-90"><span class="i18n-bn bn-body">নেফ্রোলজিস্ট থেকে ব্লাড ব্যাংক পর্যন্ত — ক্যাটাগরি অনুযায়ী দ্রুত খুঁজে নিন।</span><span class="i18n-en">From nephrologists to blood banks — find the right contact by category, fast.</span></p>
      </div>
      <div class="grid grid-cols-2 gap-3.5 sm:grid-cols-3">
        {EMERGENCY_CATEGORIES.map((c) => (
          <a class="rounded-lg border border-[color-mix(in_srgb,var(--color-accent-ink)_30%,transparent)] bg-[color-mix(in_srgb,var(--color-accent-ink)_12%,transparent)] p-4.5 hover:bg-[color-mix(in_srgb,var(--color-accent-ink)_20%,transparent)]" href={`${base}/emergency-contacts/${c.slug}`}>
            <span class="block text-sm font-semibold"><span class="i18n-bn bn">{c.labelBn}</span><span class="i18n-en">{c.labelEn}</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ TEASERS ============ -->
  <section class="py-14">
    <div class="mx-auto grid max-w-6xl gap-4 px-6 md:grid-cols-2 md:px-10">
      <a class="flex items-end justify-between gap-4 rounded-lg bg-(--color-deep) p-7 text-(--color-deep-ink) no-underline" href={`${base}/executive-body`}>
        <div>
          <h3 class="font-display text-[1.15rem] font-semibold"><span class="i18n-bn bn">কার্যনির্বাহী পরিষদ</span><span class="i18n-en">Executive Body</span></h3>
          <p class="mt-1.5 text-sm opacity-85"><span class="i18n-bn bn-body">যারা BKPA ফাউন্ডেশন পরিচালনা করছেন তাদের সাথে পরিচিত হন</span><span class="i18n-en">Meet the volunteers leading BKPA Foundation</span></p>
        </div>
      </a>
      <a class="flex items-end justify-between gap-4 rounded-lg bg-(--color-deep) p-7 text-(--color-deep-ink) no-underline" href={`${base}/faq`}>
        <div>
          <h3 class="font-display text-[1.15rem] font-semibold"><span class="i18n-bn bn">প্রায় জিজ্ঞাসিত প্রশ্ন</span><span class="i18n-en">FAQ</span></h3>
          <p class="mt-1.5 text-sm opacity-85"><span class="i18n-bn bn-body">কিডনি স্বাস্থ্য নিয়ে সাধারণ প্রশ্নের উত্তর</span><span class="i18n-en">Common questions about kidney health, answered</span></p>
        </div>
      </a>
    </div>
  </section>
</BaseLayout>
