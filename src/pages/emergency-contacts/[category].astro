---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InitialsAvatar from "../../components/InitialsAvatar.astro";
import { getCollection, render } from "astro:content";
import { EMERGENCY_CATEGORIES } from "../../lib/categories";

export async function getStaticPaths() {
  const all = await getCollection("emergencyContacts");
  return all.map((entry) => ({ params: { category: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const meta = EMERGENCY_CATEGORIES.find((c) => c.slug === entry.id);
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const items = entry.data.items ?? [];

let prevGroup: string | undefined;
---

<BaseLayout title={entry.data.title} description={`Emergency contact list — ${entry.data.title}, BKPA Foundation`}>
  <section class="bg-(--color-deep) py-10 text-(--color-deep-ink)">
    <div class="mx-auto max-w-5xl px-6 md:px-10">
      <p class="text-eyebrow opacity-75"><span class="i18n-bn bn">জরুরি যোগাযোগ</span><span class="i18n-en">Emergency Contacts</span></p>
      <h1 class="mt-1.5 text-display-2">
        <span class="i18n-en">{meta?.labelEn ?? entry.data.title}</span>
        <span class="i18n-bn bn block">{meta?.labelBn}</span>
      </h1>
    </div>
  </section>
  <nav class="border-b border-(--color-line) bg-(--color-surface)">
    <div class="mx-auto flex max-w-5xl flex-wrap gap-2 px-6 py-3 md:px-10">
      {EMERGENCY_CATEGORIES.map((c) => (
        <a
          class:list={[
            "rounded-full border px-3.5 py-1.5 text-xs font-semibold",
            c.slug === entry.id ? "border-(--color-deep) bg-(--color-deep) text-(--color-deep-ink)" : "border-(--color-line) text-(--color-ink-soft) hover:text-(--color-ink)",
          ]}
          href={`${base}/emergency-contacts/${c.slug}`}
        >
          <span class="i18n-bn bn">{c.labelBn}</span><span class="i18n-en">{c.labelEn}</span>
        </a>
      ))}
    </div>
  </nav>

  {items.length > 0 ? (
    <article class="py-12">
      <div class="mx-auto max-w-5xl px-6 md:px-10">
        {entry.data.intro && <p class="mb-8 max-w-3xl text-(--color-ink-soft)">{entry.data.intro}</p>}
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((item) => {
            const showGroupHeading = item.group && item.group !== prevGroup;
            prevGroup = item.group;
            return (
              <>
                {showGroupHeading && (
                  <h2 class="col-span-full mt-2 font-mono text-xs font-semibold tracking-wider text-(--color-ink-soft) uppercase first:mt-0">{item.group}</h2>
                )}
                <div class="flex gap-4 rounded-lg border border-(--color-line) bg-(--color-surface) p-5">
                  <InitialsAvatar name={item.name} class="h-12 w-12 text-sm" />
                  <div class="min-w-0">
                    <h3 class="text-display-4">{item.name}</h3>
                    {item.role && <p class="mt-0.5 text-sm text-(--color-ink-soft)">{item.role}</p>}
                    {item.address && <p class="mt-1.5 text-sm text-(--color-ink-soft)">{item.address}</p>}
                    <div class="mt-2 flex flex-col gap-0.5 font-mono text-xs text-(--color-ink-soft)">
                      {item.phone && <span>{item.phone}</span>}
                      {item.email && (
                        <a class="hover:text-(--color-deep)" href={`mailto:${item.email}`}>{item.email}</a>
                      )}
                      {item.website && (
                        <a class="hover:text-(--color-deep)" href={item.website.startsWith("http") ? item.website : `https://${item.website}`} target="_blank" rel="noopener">
                          {item.website}
                        </a>
                      )}
                    </div>
                    {item.notes && <p class="mt-2 text-xs text-(--color-ink-soft) italic">{item.notes}</p>}
                  </div>
                </div>
              </>
            );
          })}
        </div>
      </div>
    </article>
  ) : (
    <article class="py-12">
      <div class="mx-auto max-w-3xl px-6 md:px-10">
        <div class="prose-bkpa">
          <Content />
        </div>
      </div>
    </article>
  )}
</BaseLayout>
