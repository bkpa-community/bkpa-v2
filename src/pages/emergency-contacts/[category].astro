---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { EMERGENCY_CATEGORIES } from "../../lib/categories";

export async function getStaticPaths() {
  const all = await getCollection("emergencyContacts");
  return all.map((entry) => ({ params: { category: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const meta = EMERGENCY_CATEGORIES.find((c) => c.slug === entry.id);
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title={entry.data.title} description={`Emergency contact list — ${entry.data.title}, BKPA Foundation`}>
  <section class="bg-(--color-accent) py-10 text-(--color-accent-ink)">
    <div class="mx-auto max-w-3xl px-6 md:px-10">
      <p class="font-mono text-[0.72rem] tracking-wider opacity-75 uppercase"><span class="i18n-bn bn">জরুরি যোগাযোগ</span><span class="i18n-en">Emergency Contacts</span></p>
      <h1 class="mt-1.5 font-display text-[clamp(1.7rem,3.6vw,2.4rem)] font-semibold">
        <span class="i18n-en">{meta?.labelEn ?? entry.data.title}</span>
        <span class="i18n-bn bn block">{meta?.labelBn}</span>
      </h1>
    </div>
  </section>
  <nav class="border-b border-(--color-line) bg-(--color-surface)">
    <div class="mx-auto flex max-w-3xl flex-wrap gap-2 px-6 py-3 md:px-10">
      {EMERGENCY_CATEGORIES.map((c) => (
        <a
          class:list={[
            "rounded-full border px-3.5 py-1.5 text-xs font-semibold",
            c.slug === entry.id ? "border-(--color-deep) bg-(--color-deep) text-(--color-deep-ink)" : "border-(--color-line) text-(--color-ink-soft) hover:text-(--color-ink)",
          ]}
          href={`${base}/emergency-contacts/${c.slug}`}
        >
          <span class="i18n-bn bn">{c.labelBn}</span><span class="i18n-en">{c.labelEn}</span>
        </a>
      ))}
    </div>
  </nav>
  <article class="py-12">
    <div class="mx-auto max-w-3xl px-6 md:px-10">
      <div class="prose-bkpa">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
