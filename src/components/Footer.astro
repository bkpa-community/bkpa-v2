---
import { CATEGORIES, EMERGENCY_CATEGORIES } from "../lib/categories";
---

<footer class="border-t border-(--color-line) bg-(--color-surface)">
  <div class="mx-auto grid max-w-6xl gap-9 px-6 py-12 md:grid-cols-[1.4fr_1fr_1fr_1fr] md:px-10">
    <div>
      <a class="flex items-center gap-2.5 no-underline" href="/">
        <svg class="h-8 w-8 flex-none" viewBox="0 0 48 48" fill="none" aria-hidden="true">
          <path d="M24 5c-8 0-13 7.5-13 16.5C11 33 16.5 43 24 43s13-10 13-21.5C37 12.5 32 5 24 5Z" fill="var(--color-deep)"></path>
          <circle cx="24" cy="21" r="4.4" fill="var(--color-paper)"></circle>
        </svg>
        <span class="font-display text-[1.05rem] font-semibold">BKPA Foundation</span>
      </a>
      <p class="mt-3.5 max-w-sm text-[0.88rem] text-(--color-ink-soft)">
        <span class="i18n-bn bn-body">বাংলাদেশ কিডনি পেশেন্ট অ্যাসোসিয়েশন ফাউন্ডেশন — কিডনি রোগ প্রতিরোধে সচেতনতা ও সম্প্রদায়ভিত্তিক উদ্যোগ। প্রতিষ্ঠা: এপ্রিল ২০১৫।</span>
        <span class="i18n-en">Bangladesh Kidney Patient Association Foundation — building awareness and community around kidney disease prevention. Founded April 2015.</span>
      </p>
    </div>
    <div>
      <h4 class="mb-3.5 font-mono text-[0.7rem] tracking-wider text-(--color-ink-soft) uppercase">
        <span class="i18n-bn bn">কিডনি সম্পর্কে জানুন</span><span class="i18n-en">Know Your Kidney</span>
      </h4>
      <ul class="flex flex-col gap-2.5">
        {CATEGORIES.slice(0, 4).map((c) => (
          <li><a class="text-sm hover:text-(--color-accent)" href={`/know-your-kidney/${c.slug}`}><span class="i18n-bn bn">{c.labelBn}</span><span class="i18n-en">{c.labelEn}</span></a></li>
        ))}
      </ul>
    </div>
    <div>
      <h4 class="mb-3.5 font-mono text-[0.7rem] tracking-wider text-(--color-ink-soft) uppercase">
        <span class="i18n-bn bn">জরুরি যোগাযোগ</span><span class="i18n-en">Emergency Contacts</span>
      </h4>
      <ul class="flex flex-col gap-2.5">
        {EMERGENCY_CATEGORIES.slice(0, 4).map((c) => (
          <li><a class="text-sm hover:text-(--color-accent)" href={`/emergency-contacts/${c.slug}`}><span class="i18n-bn bn">{c.labelBn}</span><span class="i18n-en">{c.labelEn}</span></a></li>
        ))}
      </ul>
    </div>
    <div>
      <h4 class="mb-3.5 font-mono text-[0.7rem] tracking-wider text-(--color-ink-soft) uppercase">
        <span class="i18n-bn bn">সংগঠন</span><span class="i18n-en">Organization</span>
      </h4>
      <ul class="flex flex-col gap-2.5">
        <li><a class="text-sm hover:text-(--color-accent)" href="/executive-body"><span class="i18n-bn bn">কার্যনির্বাহী পরিষদ</span><span class="i18n-en">Executive Body</span></a></li>
        <li><a class="text-sm hover:text-(--color-accent)" href="https://www.facebook.com/groups/bkpafoundation" target="_blank" rel="noopener">Facebook</a></li>
        <li><a class="text-sm hover:text-(--color-accent)" href="/contact"><span class="i18n-bn bn">যোগাযোগ</span><span class="i18n-en">Contact</span></a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-(--color-line)">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-6 py-4 text-[0.8rem] text-(--color-ink-soft) md:px-10">
      <span
        >© {new Date().getFullYear()} BKPA Foundation.<span class="i18n-bn bn"> সর্বস্বত্ব সংরক্ষিত।</span><span class="i18n-en"> All rights reserved.</span></span
      >
      <a class="underline" href="https://mehedisharif.com" target="_blank" rel="noopener">Developed by Mehedi</a>
    </div>
  </div>
</footer>
