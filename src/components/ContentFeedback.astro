---
const year = new Date().getFullYear();
---

<div class="content-feedback rounded-xl border-2 border-(--color-accent-2) bg-(--color-surface) p-6 text-center md:p-8">
  <p class="font-display text-[1.15rem] font-semibold text-(--color-ink)">
    <span class="i18n-bn bn">এই কনটেন্টটি কতটা সহায়ক ছিল?</span>
    <span class="i18n-en">How helpful was this content?</span>
  </p>

  <div class="mt-4 flex items-center justify-center gap-1.5" role="radiogroup" aria-label="Content rating">
    {[1, 2, 3, 4, 5].map((n) => (
      <button type="button" class="cf-star p-0.5" data-value={n} role="radio" aria-checked="false" aria-label={`${n} star${n > 1 ? "s" : ""}`}>
        <svg viewBox="0 0 24 24" class="h-7 w-7 md:h-8 md:w-8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
          <path d="M12 2.5l2.9 6.15 6.6.79-4.9 4.63 1.3 6.63L12 17.9l-5.9 2.8 1.3-6.63-4.9-4.63 6.6-.79L12 2.5Z"></path>
        </svg>
      </button>
    ))}
  </div>

  <p class="cf-thanks mt-3 hidden text-sm font-semibold text-(--color-deep)">
    <span class="i18n-bn bn">আপনার মতামতের জন্য ধন্যবাদ!</span>
    <span class="i18n-en">Thanks for your feedback!</span>
  </p>

  <div class="mt-6 border-t border-(--color-line) pt-5 text-left text-xs text-(--color-ink-soft)">
    <p>
      <span class="i18n-bn bn-body">এই তথ্যটি শুধুমাত্র সাধারণ ধারণা দেওয়ার উদ্দেশ্যে প্রদান করা হয়েছে এবং এটি কোনো চিকিৎসা পরামর্শের বিকল্প নয়। রোগ নির্ণয় ও চিকিৎসার জন্য অনুগ্রহ করে একজন যোগ্য চিকিৎসকের পরামর্শ নিন।</span>
      <span class="i18n-en">This content is provided for informational purposes only and is not a substitute for professional medical advice. Please consult a qualified doctor for diagnosis and treatment.</span>
    </p>
    <p class="mt-2">
      © {year} BKPA Foundation.<span class="i18n-bn bn"> সর্বস্বত্ব সংরক্ষিত।</span><span class="i18n-en"> All rights reserved.</span>
    </p>
  </div>
</div>

<style>
  .cf-star svg {
    color: var(--color-line);
    transition: color 0.1s;
  }
  .cf-star.is-filled svg {
    color: var(--color-accent-2);
    fill: var(--color-accent-2);
  }
</style>

<script>
  function initContentFeedback(root: ParentNode) {
    const stars = Array.from(root.querySelectorAll<HTMLButtonElement>(".cf-star"));
    const thanks = root.querySelector<HTMLElement>(".cf-thanks");
    if (stars.length === 0) return;

    const key = `bkpa-rating:${location.pathname}`;
    let rating = 0;
    try {
      rating = Number(localStorage.getItem(key)) || 0;
    } catch {}

    function paint(upTo: number) {
      stars.forEach((btn, i) => {
        btn.classList.toggle("is-filled", i < upTo);
        btn.setAttribute("aria-checked", String(i < upTo));
      });
    }

    function setRating(n: number) {
      rating = n;
      paint(n);
      thanks?.classList.remove("hidden");
      try {
        localStorage.setItem(key, String(n));
      } catch {}
    }

    if (rating > 0) {
      paint(rating);
      thanks?.classList.remove("hidden");
    }

    stars.forEach((btn, i) => {
      btn.addEventListener("mouseenter", () => paint(i + 1));
      btn.addEventListener("mouseleave", () => paint(rating));
      btn.addEventListener("click", () => setRating(i + 1));
    });
  }

  document.querySelectorAll(".content-feedback").forEach((el) => initContentFeedback(el));
</script>
