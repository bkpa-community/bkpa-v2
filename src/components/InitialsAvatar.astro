---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = "h-16 w-16 text-lg" } = Astro.props;

const TITLE_PREFIXES = [
  "ডক্টর",
  "ডাক্তার",
  "ডাঃ",
  "ড.",
  "Dr.",
  "Dr",
  "Prof.",
  "Prof",
  "Mrs.",
  "Md.",
];

function stripTitle(raw: string) {
  let n = raw.trim();
  for (const prefix of TITLE_PREFIXES) {
    if (n.startsWith(prefix + " ") || n.startsWith(prefix)) {
      n = n.slice(prefix.length).trim();
      break;
    }
  }
  return n || raw.trim();
}

function initialsFor(raw: string) {
  const cleaned = stripTitle(raw).replace(/[()."'”“]/g, "");
  const words = cleaned.split(/\s+/).filter(Boolean);
  if (words.length === 0) return "?";
  if (words.length === 1) return [...words[0]].slice(0, 2).join("");
  return [...words[0]][0] + [...words[1]][0];
}

const initials = initialsFor(name);
---

<span class={`inline-flex flex-none items-center justify-center rounded-full bg-(--color-deep) font-display font-semibold text-(--color-deep-ink) ${className}`}>
  {initials}
</span>
